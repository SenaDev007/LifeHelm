# ─── Base de données Neon PostgreSQL ─────────────────────────────────────────
# IMPORTANT — connexion DIRECTE (sans le suffixe -pooler) pour le runtime :
# les transactions interactives Prisma ($transaction) sont incompatibles avec
# le mode transaction-pooling de PgBouncer. Une API mono-instance gère très
# bien son propre pool de connexions côté Prisma.
# Le pooler (-pooler) reste utile pour les environnements serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/LifeHelm?sslmode=require&connection_limit=10"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/LifeHelm?sslmode=require"

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Sécurité ────────────────────────────────────────────────────────────────
# Générer un secret fort : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-svp-48-octets-hex"
BCRYPT_ROUNDS=10

# ─── Sessions (D01.3 — arbitrages) ───────────────────────────────────────────
ACCESS_TOKEN_TTL_MIN=15        # jeton d'accès court
REFRESH_TOKEN_TTL_DAYS=30      # session glissante 30 j (renouvelée à chaque rotation)
RESET_TOKEN_TTL_MIN=30         # réinitialisation mot de passe
VERIFY_CODE_TTL_HOURS=24       # vérification courriel/téléphone
